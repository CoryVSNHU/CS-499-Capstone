<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}} - Travlr Getaways</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>

<body>
    <div id="background">
        <div id="page">

            <div id="header">
                <div id="logo">
                    <a href="/">
                        <img src="/images/logo.png"
                             alt="Travlr Getaways Logo"
                             height="100"
                             width="200">
                    </a>
                </div>
            </div>

            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">

                            <h1>Book Your Trip</h1>

<h2>{{trip.name}}</h2>

<p>
    <strong>${{trip.price}} per traveler</strong>
</p>
{{#if error}}
    <div class="reservation-error">
        <p><strong>{{error}}</strong></p>
    </div>
{{/if}}
<form action="/travel/reservation/{{trip.code}}" method="POST">

    <p>
        <label for="name"><strong>Full Name:</strong></label><br>
        <input
    type="text"
    id="name"
    name="name"
    value="{{formData.name}}"
    required
>
    </p>

    <p>
        <label for="email"><strong>Email:</strong></label><br>
        <input
    type="email"
    id="email"
    name="email"
    value="{{formData.email}}"
    required
>
    </p>

    <p>
        <label for="travelers"><strong>Number of Travelers:</strong></label><br>
        <input
    type="number"
    id="travelers"
    name="travelers"
    min="1"
    max="10"
    value="{{#if formData.travelers}}{{formData.travelers}}{{else}}1{{/if}}"
    required
        >
    </p>

    <p>
        <label for="travelDate"><strong>Travel Date:</strong></label><br>
        <input
    type="date"
    id="travelDate"
    name="travelDate"
    value="{{formData.travelDate}}"
    required
>

    <input
        type="hidden"
        name="tripCode"
        value="{{trip.code}}"
    >

    <p>
        <button type="submit">
            Complete Reservation
        </button>
    </p>

</form>

<p>
    <a href="/travel">Return to Travel</a>
</p>
                            </p>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</body>
</html>