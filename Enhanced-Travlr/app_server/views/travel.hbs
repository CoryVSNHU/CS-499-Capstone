<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}} - Travel</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>

<body>
    <div id="background">
        <div id="page">

            <div id="header">
                <div id="logo">
                    <a href="/">
                        <img src="/images/logo.png"
                             alt="Travlr Getaways Logo"
                             height="100"
                             width="200">
                    </a>
                </div>

                <div id="navigation">
                    <ul>
                        <li>
                            <a href="/index.html">Home</a>
                        </li>
                        <li class="selected">
                            <a href="/travel">Travel</a>
                        </li>
                        <li>
                            <a href="/rooms.html">Rooms</a>
                        </li>
                        <li>
                            <a href="/meals.html">Meals</a>
                        </li>
                        <li>
                            <a href="/news.html">News</a>
                        </li>
                        <li>
                            <a href="/about.html">About</a>
                        </li>
                        <li>
                            <a href="/contact.html">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>

            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">

                            <h1>Travel</h1>
                            <div class="trip-search">
    <h2>Find Your Trip</h2>

    <form action="/travel" method="GET">

        <div>
            <label for="search">Search Trips</label>
            <input
                type="text"
                id="search"
                name="search"
                placeholder="Search by name or description"
                value="{{search}}"
            >
        </div>

        <div>
            <label for="maxPrice">Maximum Price</label>
            <input
                type="number"
                id="maxPrice"
                name="maxPrice"
                min="0"
                placeholder="Maximum price"
                value="{{maxPrice}}"
            >
        </div>

        <div>
            <label for="sort">Sort Trips</label>

            <select
    id="sort"
    name="sort"
    onchange="this.form.submit()"
>
    <option value="">
        Default Order
    </option>

    <option
        value="priceLow"
        {{#if sortPriceLow}}selected{{/if}}
    >
        Price: Low to High
    </option>

    <option
        value="priceHigh"
        {{#if sortPriceHigh}}selected{{/if}}
    >
        Price: High to Low
    </option>

    <option
        value="name"
        {{#if sortName}}selected{{/if}}
    >
        Name: A to Z
    </option>
</select>
        </div>

        <button type="submit">
            Search
        </button>

        <a href="/travel">
            Clear Filters
        </a>

    </form>
</div>

                            {{#if trips.length}}

    <ul id="sites">

        {{#each trips}}

        <li>
            <img src="/images/{{image}}"
                 alt="{{name}}">

            <h2>{{name}}</h2>

            <p>
                {{description}}
            </p>

            <p>
                <strong>
                    ${{price}} per traveler
                </strong>
            </p>

            <p>
                <a href="/travel/reservation/{{code}}">
                    Book This Trip
                </a>
            </p>
        </li>

        {{/each}}

    </ul>

{{else}}

    <div class="no-results">
        <h2>No Trips Found</h2>
        <p>
            No trips matched your search criteria.
            Try changing your search or price range.
        </p>

        <a href="/travel">
            View All Trips
        </a>
    </div>

{{/if}}

                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div id="footer">
            <div>
                <ul class="navigation">
                    <li>
                        <a href="/index.html">Home</a>
                    </li>

                    <li class="active">
                        <a href="/travel">Travel</a>
                    </li>

                    <li>
                        <a href="/rooms.html">Rooms</a>
                    </li>

                    <li>
                        <a href="/meals.html">Meals</a>
                    </li>

                    <li>
                        <a href="/news.html">News</a>
                    </li>

                    <li>
                        <a href="/about.html">About</a>
                    </li>

                    <li>
                        <a href="/contact.html">Contact</a>
                    </li>
                </ul>
            </div>

            <p>
                © 2026 Travlr Getaways. All Rights Reserved.
            </p>
        </div>

    </div>
</body>
</html>